{
  "name": "jobhunter",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agentic job search command center with a provider-backed orchestrator.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check app.js && node --check career-ops-sources.js && npm test",
    "ollama:apple": "./scripts/run-ollama.sh apple",
    "ollama:docker": "./scripts/run-ollama.sh docker",
    "ollama:pull": "./scripts/ollama-model.sh pull",
    "ollama:list": "./scripts/ollama-model.sh list",
    "container:apple:build": "container build --tag jobhunter-orchestrator --file Containerfile .",
    "container:apple:run": "./scripts/run-orchestrator.sh apple",
    "container:docker:build": "docker build --tag jobhunter-orchestrator --file Dockerfile .",
    "container:docker:run": "./scripts/run-orchestrator.sh docker"
  }
}
