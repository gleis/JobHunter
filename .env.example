# Optional provider keys. Ollama does not need a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# The project can run Ollama in its own Apple Container. The Apple stack sets
# the orchestrator to http://jobhunter-ollama.test:11434 by default.
#
# Docker Compose sets the orchestrator to http://ollama:11434.
# The Docker script defaults to http://host.docker.internal:11434 because it
# starts Ollama as a separately published container.
OLLAMA_BASE_URL=

# Optional container controls.
JOBHUNTER_OLLAMA_MODEL=llama3.1:8b
JOBHUNTER_OLLAMA_MEMORY=8g
JOBHUNTER_OLLAMA_CPUS=6
JOBHUNTER_OLLAMA_STORE=${HOME}/.jobhunter/ollama
JOBHUNTER_DATA_STORE=${HOME}/.jobhunter/data
